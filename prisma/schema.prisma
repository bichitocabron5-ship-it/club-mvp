// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Member {
  id                Int       @id @default(autoincrement())
  memberNumber      String?   @unique
  fullName          String
  dni               String    @unique
  phone             String?
  email             String?
  photoUrl          String?
  dniFrontUrl       String?
  dniBackUrl        String?
  active            Boolean   @default(true)
  joinedAt          DateTime  @default(now())
  expiresAt         DateTime?
  rfidCode          String?   @unique
  createdAt         DateTime  @default(now())
  commercialProfile String    @default("STANDARD")
  discountPercent   Float     @default(0)
  commercialNotes   String?

  sales           Sale[]
  contracts       MemberContract[]
  signingSessions SigningSession[]
  accessLogs      AccessLog[]
  appUser         AppUser?
}

model AccessLog {
  id       Int    @id @default(autoincrement())
  memberId Int
  member   Member @relation(fields: [memberId], references: [id])

  type      String // "IN" | "OUT"
  createdAt DateTime @default(now())
}

model AppUser {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("STAFF") // ADMIN | STAFF
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  memberId     Int?     @unique

  member       Member?  @relation(fields: [memberId], references: [id])
  appliedSales Sale[]   @relation("SaleAppliedByUser")
  auditLogs    AuditLog[]
  createdInventoryCounts   InventoryCount[] @relation("InventoryCountCreatedByUser")
  confirmedInventoryCounts InventoryCount[] @relation("InventoryCountConfirmedByUser")
  closedDayClosures        DayClosure[]     @relation("DayClosureClosedByUser")
  reopenedDayClosures      DayClosure[]     @relation("DayClosureReopenedByUser")
  createdCashMoves         CashMove[]       @relation("CashMoveCreatedByUser")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  actorUserId Int?
  actorEmail  String?
  action      String
  entityType  String
  entityId    String?
  summary     String
  metadata    Json?
  createdAt   DateTime @default(now())

  actorUser AppUser? @relation(fields: [actorUserId], references: [id])
}

model Product {
  id          Int    @id @default(autoincrement())
  name        String
  sku         String? @unique
  description String? @db.Text
  unit        String // "G" o "UD"
  price       Float
  stock       Float  @default(0)
  reserveStock Float @default(0)
  averageCost Float  @default(0)
  imageUrl    String?

  category String  @default("CANNABIS")
  hashType String?
  minStock Float   @default(5)

  createdAt DateTime @default(now())
  active    Boolean  @default(true)

  sales         Sale[]
  stockMoves    StockMove[]
  purchaseItems PurchaseItem[]
  inventoryCountItems InventoryCountItem[]
}

model InventoryCount {
  id                Int                  @id @default(autoincrement())
  status            String               @default("OPEN") // OPEN | CONFIRMED | CANCELLED
  type              String               @default("PARTIAL") // PARTIAL | FULL | CLOSING | AUDIT
  createdByUserId   Int?
  confirmedByUserId Int?
  notes             String?
  createdAt         DateTime             @default(now())
  confirmedAt       DateTime?
  cancelledAt       DateTime?

  createdByUser   AppUser?             @relation("InventoryCountCreatedByUser", fields: [createdByUserId], references: [id])
  confirmedByUser AppUser?             @relation("InventoryCountConfirmedByUser", fields: [confirmedByUserId], references: [id])
  items           InventoryCountItem[]
  dayClosures     DayClosure[]
}

model InventoryCountItem {
  id               Int            @id @default(autoincrement())
  inventoryCountId Int
  productId        Int
  expectedQty      Float
  countedQty       Float?
  differenceQty    Float?
  note             String?
  createdAt        DateTime       @default(now())

  inventoryCount InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id])

  @@unique([inventoryCountId, productId])
}

model StockMove {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id])

  type          String // IN | OUT | ADJUST | TRANSFER | INVENTORY_ADJUSTMENT
  qty           Float
  previousStock Float
  newStock      Float
  note          String?
  createdAt     DateTime @default(now())
}

model Sale {
  id              Int      @id @default(autoincrement())
  memberId        Int
  productId       Int
  qty             Float
  totalAmount     Float
  unitCost        Float    @default(0)
  profit          Float    @default(0)
  note            String?
  createdAt       DateTime @default(now())
  originalAmount  Float?
  discountPercent Float    @default(0)
  discountAmount  Float    @default(0)
  finalAmount     Float?
  discountReason  String?
  discountSource  String   @default("NONE") // NONE | MEMBER_PROFILE | MANUAL
  appliedByUserId Int?

  member        Member   @relation(fields: [memberId], references: [id])
  product       Product  @relation(fields: [productId], references: [id])
  appliedByUser AppUser? @relation("SaleAppliedByUser", fields: [appliedByUserId], references: [id])
}

model CashMove {
  id              Int      @id @default(autoincrement())
  type            String // income / expense
  amount          Float
  note            String?
  source          String   @default("MANUAL") // SALE | EXPENSE | PURCHASE_PAYMENT | MANUAL | ADJUSTMENT | OTHER
  sourceId        String?
  paymentMethod   String   @default("CASH") // CASH | CARD | TRANSFER | OTHER
  createdByUserId Int?
  day             String?
  createdAt       DateTime @default(now())

  createdByUser AppUser? @relation("CashMoveCreatedByUser", fields: [createdByUserId], references: [id])
}

model DayClosure {
  id           Int    @id @default(autoincrement())
  day          String @unique
  totalIncome  Float  @default(0)
  totalExpense Float  @default(0)
  balance      Float  @default(0)

  expectedCash Float @default(0)
  countedCash  Float @default(0)
  difference   Float @default(0)
  salesTotal   Float @default(0)
  expensesTotal Float @default(0)
  manualCashTotal Float @default(0)
  discountsTotal Float @default(0)
  closedByUserId Int?
  inventoryCountId Int?
  reopenedAt DateTime?
  reopenedByUserId Int?
  reopenReason String?

  note      String?
  createdAt DateTime @default(now())

  closedByUser   AppUser?        @relation("DayClosureClosedByUser", fields: [closedByUserId], references: [id])
  inventoryCount InventoryCount? @relation(fields: [inventoryCountId], references: [id])
  reopenedByUser AppUser?        @relation("DayClosureReopenedByUser", fields: [reopenedByUserId], references: [id])
}

model Expense {
  id          Int      @id @default(autoincrement())
  category    String
  description String
  amount      Float
  paidMethod  String   @default("CASH")
  createdAt   DateTime @default(now())
}

model ContractTemplate {
  id        Int      @id @default(autoincrement())
  name      String
  version   String
  fileUrl   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  contracts MemberContract[]
}

model MemberContract {
  id                 Int  @id @default(autoincrement())
  memberId           Int
  signingSessionId   Int? @unique
  contractTemplateId Int?

  fullName         String
  dni              String
  address          String?
  birthPlace       String?
  birthDate        DateTime?
  phone            String?
  email            String?
  consumptionGrams Int?

  signatureImage String   @db.Text
  signedPdfUrl   String?
  signedAt       DateTime @default(now())

  member           Member            @relation(fields: [memberId], references: [id])
  contractTemplate ContractTemplate? @relation(fields: [contractTemplateId], references: [id])
  signingSession   SigningSession?   @relation(fields: [signingSessionId], references: [id])
}

model SigningSession {
  id             Int       @id @default(autoincrement())
  token          String    @unique
  memberId       Int
  status         String    @default("PENDING") // PENDING / SIGNED / CANCELLED
  signatureImage String?   @db.Text
  signedAt       DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  member   Member          @relation(fields: [memberId], references: [id])
  contract MemberContract?
}

model ClubSetting {
  id                   Int      @id @default(1)
  dailyLimitG          Float    @default(10)
  dailyLimitUd         Int      @default(15)
  defaultMonthlyLimitG Int      @default(30)
  updatedAt            DateTime @updatedAt
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  purchases Purchase[]
}

model Purchase {
  id         Int      @id @default(autoincrement())
  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  totalAmount Float
  paidAmount  Float    @default(0)
  status      String   @default("PENDING") // PENDING | PARTIAL | PAID
  note        String?
  createdAt   DateTime @default(now())

  items PurchaseItem[]
}

model PurchaseItem {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id])

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  qty          Float
  availableQty Float    @default(0)
  reserveQty   Float    @default(0)
  unitCost     Float
  lineTotal    Float
}
