// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Member {
  id        Int       @id @default(autoincrement())
  fullName  String
  dni       String    @unique
  phone     String?
  email     String?
  active    Boolean   @default(true)
  joinedAt  DateTime  @default(now())
  expiresAt DateTime?
  rfidCode  String?   @unique
  createdAt DateTime  @default(now())

  sales           Sale[]
  contracts       MemberContract[]
  signingSessions SigningSession[]
  accessLogs      AccessLog[]
}

model AccessLog {
  id       Int    @id @default(autoincrement())
  memberId Int
  member   Member @relation(fields: [memberId], references: [id])

  type      String // "IN" | "OUT"
  createdAt DateTime @default(now())
}

model AppUser {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("STAFF") // ADMIN | STAFF
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Product {
  id          Int    @id @default(autoincrement())
  name        String
  unit        String // "G" o "UD"
  price       Float
  stock       Float  @default(0)
  averageCost Float  @default(0)

  category String @default("CANNABIS")
  minStock Float  @default(5)

  createdAt DateTime @default(now())
  active    Boolean  @default(true)

  sales         Sale[]
  stockMoves    StockMove[]
  purchaseItems PurchaseItem[]
}

model StockMove {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id])

  type          String // IN | OUT | ADJUST
  qty           Float
  previousStock Float
  newStock      Float
  note          String?
  createdAt     DateTime @default(now())
}

model Sale {
  id          Int      @id @default(autoincrement())
  memberId    Int
  productId   Int
  qty         Float
  totalAmount Float
  unitCost    Float    @default(0)
  profit      Float    @default(0)
  note        String?
  createdAt   DateTime @default(now())

  member  Member  @relation(fields: [memberId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model CashMove {
  id        Int      @id @default(autoincrement())
  type      String // income / expense
  amount    Float
  note      String?
  createdAt DateTime @default(now())
}

model DayClosure {
  id           Int    @id @default(autoincrement())
  day          String @unique
  totalIncome  Float  @default(0)
  totalExpense Float  @default(0)
  balance      Float  @default(0)

  expectedCash Float @default(0)
  countedCash  Float @default(0)
  difference   Float @default(0)

  note      String?
  createdAt DateTime @default(now())
}

model Expense {
  id          Int      @id @default(autoincrement())
  category    String
  description String
  amount      Float
  paidMethod  String   @default("CASH")
  createdAt   DateTime @default(now())
}

model ContractTemplate {
  id        Int      @id @default(autoincrement())
  name      String
  version   String
  fileUrl   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  contracts MemberContract[]
}

model MemberContract {
  id                 Int  @id @default(autoincrement())
  memberId           Int
  signingSessionId   Int? @unique
  contractTemplateId Int?

  fullName         String
  dni              String
  address          String?
  birthPlace       String?
  birthDate        DateTime?
  phone            String?
  email            String?
  consumptionGrams Int?

  signatureImage String   @db.Text
  signedPdfUrl   String?
  signedAt       DateTime @default(now())

  member           Member            @relation(fields: [memberId], references: [id])
  contractTemplate ContractTemplate? @relation(fields: [contractTemplateId], references: [id])
  signingSession   SigningSession?   @relation(fields: [signingSessionId], references: [id])
}

model SigningSession {
  id             Int       @id @default(autoincrement())
  token          String    @unique
  memberId       Int
  status         String    @default("PENDING") // PENDING / SIGNED / CANCELLED
  signatureImage String?   @db.Text
  signedAt       DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  member   Member          @relation(fields: [memberId], references: [id])
  contract MemberContract?
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  purchases Purchase[]
}

model Purchase {
  id         Int      @id @default(autoincrement())
  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  totalAmount Float
  paidAmount  Float    @default(0)
  status      String   @default("PENDING") // PENDING | PARTIAL | PAID
  note        String?
  createdAt   DateTime @default(now())

  items PurchaseItem[]
}

model PurchaseItem {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id])

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  qty       Float
  unitCost  Float
  lineTotal Float
}
