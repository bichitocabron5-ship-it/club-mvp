// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Member {
  id        Int      @id @default(autoincrement())
  fullName  String
  dni       String   @unique
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  sales     Sale[]
  contracts MemberContract[]
  signingSessions SigningSession[]
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String
  unit      String   // "g" o "ud"
  price     Float
  stock     Float    @default(0)
  createdAt DateTime @default(now())

  sales     Sale[]
}

model Sale {
  id          Int      @id @default(autoincrement())
  memberId    Int
  productId   Int
  qty         Float
  totalAmount Float
  note        String?
  createdAt   DateTime @default(now())

  member  Member  @relation(fields: [memberId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model CashMove {
  id        Int      @id @default(autoincrement())
  type      String   // income / expense
  amount    Float
  note      String?
  createdAt DateTime @default(now())
}

model DayClosure {
  id           Int      @id @default(autoincrement())
  day          String   @unique
  totalIncome  Float    @default(0)
  totalExpense Float    @default(0)
  balance      Float    @default(0)
  note         String?
  createdAt    DateTime @default(now())
}

model ContractTemplate {
  id        Int      @id @default(autoincrement())
  name      String
  version   String
  fileUrl   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  contracts MemberContract[]
}

model MemberContract {
  id                 Int      @id @default(autoincrement())
  memberId           Int
  signingSessionId Int?     @unique
  contractTemplateId Int?

  fullName         String
  dni              String
  address          String?
  birthPlace       String?
  birthDate        DateTime?
  phone            String?
  email            String?
  consumptionGrams Int?

  
  signatureImage     String   @db.Text
  signedPdfUrl       String?
  signedAt           DateTime @default(now())

  member             Member           @relation(fields: [memberId], references: [id])
  contractTemplate   ContractTemplate? @relation(fields: [contractTemplateId], references: [id])
  signingSession     SigningSession? @relation(fields: [signingSessionId], references: [id])
}

model SigningSession {
  id             Int       @id @default(autoincrement())
  token          String    @unique
  memberId       Int
  status         String    @default("PENDING") // PENDING / SIGNED / CANCELLED
  signatureImage String?   @db.Text
  signedAt       DateTime?
  createdAt      DateTime  @default(now())

  member Member @relation(fields: [memberId], references: [id])
  contract MemberContract?
}