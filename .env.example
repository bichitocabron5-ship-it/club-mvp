# Base de datos PostgreSQL usada por Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Secreto para NextAuth/JWT. Genera un valor largo y aleatorio para producción.
AUTH_SECRET="replace-with-a-long-random-secret"

# URL pública/base de la app. Útil para despliegues y callbacks de autenticación.
NEXTAUTH_URL="http://localhost:3000"

# Supabase Storage para documentos, fotos y contratos.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"
STORAGE_BUCKET="club-uploads"

# Contraseña del catálogo/kiosko público interno.
CATALOG_PASSWORD="replace-with-catalog-password"

# Variables opcionales para scripts de creación de usuarios.
APP_ADMIN_NAME="Administrador"
APP_ADMIN_EMAIL="admin@example.com"
APP_ADMIN_PASSWORD="change-me"
APP_STAFF_NAME="Staff"
APP_STAFF_EMAIL="staff@example.com"
APP_STAFF_PASSWORD="change-me"

# Variables opcionales para scripts de limpieza.
CLEANUP_DRY_RUN="true"
CONFIRM_CLEANUP=""
